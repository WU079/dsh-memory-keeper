{
  "name": "dsh-memory-keeper",
  "version": "0.1.0",
  "description": "Cross-session memory for DSH: export every session to readable Markdown transcripts, keep one long-term MEMORY.md, and get a wake-up summary in a fresh window.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sessions",
    "transcript"
  ],
  "license": "MIT",
  "author": "WU079",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WU079/dsh-memory-keeper.git"
  },
  "homepage": "https://github.com/WU079/dsh-memory-keeper#readme",
  "bugs": {
    "url": "https://github.com/WU079/dsh-memory-keeper/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
